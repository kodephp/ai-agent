{
    "name": "kode/ai-agent",
    "description": "企业级 PHP AI Agent 层，兼容 Symfony AI 生态，支持协程、管道和 SSE 流式响应。新增文本生成图像、文本生成视频、数字人等多模态 API 支持，以及分工代理、主管 Agent 协调等高级功能。集成 kode/context 实现协程安全的执行上下文管理。",
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.6.0",
    "autoload": {
        "psr-4": {
            "Kode\\AiAgent\\": "src/"
        },
        "files": [
            "src/Support/Helper/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\AiAgent\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "psr/simple-cache": "^3.0",
        "nyholm/psr7": "^1.8",
        "kode/tools": "^1.0",
        "kode/context": "^2.0",
        "kode/http-client": "^2.0",
        "kode/attributes": "^1.0",
        "kode/facade": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=5"
    },
    "keywords": [
        "ai",
        "agent",
        "openai",
        "anthropic",
        "claude",
        "llm",
        "chat",
        "streaming",
        "sse",
        "php",
        "kode",
        "text-to-image",
        "text-to-video",
        "avatar",
        "multimodal",
        "dall-e",
        "supervisor",
        "multi-agent",
        "team",
        "cost-tracking",
        "context-aware",
        "coroutine-safe"
    ],
    "support": {
        "issues": "https://github.com/kodephp/ai-agent/issues",
        "source": "https://github.com/kodephp/ai-agent"
    },
    "config": {
        "sort-packages": true
    }
}
