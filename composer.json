{
    "name": "kode/ai-agent",
    "description": "企业级 PHP AI Agent 框架，兼容 Symfony AI 生态。支持短剧生成（多 Agent 协作）、多模态（文生图/视频/数字人）、Monolog 日志、Fiber 协程、进程管理、AI 字幕、配音旁白、视频剪辑、工作流预设等企业级功能。",
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.12.0",
    "autoload": {
        "psr-4": {
            "Kode\\AiAgent\\": "src/"
        },
        "files": [
            "src/Support/Helper/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\AiAgent\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "psr/simple-cache": "^3.0",
        "nyholm/psr7": "^1.8",
        "kode/tools": "^1.0",
        "kode/context": "^2.0",
        "kode/http-client": "^2.0",
        "kode/attributes": "^1.0",
        "kode/facade": "^2.0",
        "monolog/monolog": "^3.0"
    },
    "suggest": {
        "kode/fibers": "PHP Fiber 协程支持（可选，PHP 8.1+ 内置）",
        "kode/process": "系统进程管理支持（可选）",
        "symfony/process": "进程管理备选方案"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=5"
    },
    "keywords": [
        "ai",
        "agent",
        "openai",
        "anthropic",
        "claude",
        "llm",
        "chat",
        "streaming",
        "sse",
        "php",
        "kode",
        "text-to-image",
        "text-to-video",
        "avatar",
        "multimodal",
        "dall-e",
        "supervisor",
        "multi-agent",
        "team",
        "cost-tracking",
        "context-aware",
        "coroutine-safe",
        "memory-system",
        "retry-strategy",
        "monolog",
        "logging",
        "fiber",
        "parallel",
        "process",
        "drama",
        "short-video",
        "video-composer"
    ],
    "support": {
        "issues": "https://github.com/kodephp/ai-agent/issues",
        "source": "https://github.com/kodephp/ai-agent"
    },
    "config": {
        "sort-packages": true
    }
}